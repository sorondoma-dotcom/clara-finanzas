# Copia este archivo a `.env` y sustituye los valores marcados. `.env` nunca se sube a Git.
# Generar secretos:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Entorno -----------------------------------------------------------------
# development | test | production  (production exige HTTPS y cookie __Host-)
ENVIRONMENT=development

# --- PostgreSQL (servicio `db` de docker-compose) ----------------------------
POSTGRES_DB=clara
POSTGRES_USER=clara
# Usa solo letras, números, - y _ para no tener que codificarla en la URL.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

# URL usada al ejecutar la API fuera de Docker (uvicorn local, pytest, alembic).
# Dentro de Docker Compose se sobrescribe para apuntar al host `db`.
DATABASE_URL=postgresql+psycopg://clara:change-me-postgres-password@127.0.0.1:5432/clara
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- API ---------------------------------------------------------------------
# Firma los tokens CSRF. Mínimo 32 caracteres, distinto en cada entorno.
SECRET_KEY=change-me-generate-a-long-random-secret-key
# Orígenes exactos (esquema + host + puerto) desde los que se permite escribir, separados por comas.
# 5173 = Vite en desarrollo · 8000 = contenedor `api` sirviendo la web compilada.
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
API_PORT=8000
# Intentos de inicio de sesión por IP cada 15 minutos.
AUTH_RATE_LIMIT=20
# Peticiones a la API por IP y minuto (por proceso).
API_RATE_LIMIT=180
# Proxies de confianza para X-Forwarded-For/Proto. En Render u otro PaaS tras su balanceador: *
FORWARDED_ALLOW_IPS=127.0.0.1
# Procesos de uvicorn en el contenedor.
WEB_CONCURRENCY=2
